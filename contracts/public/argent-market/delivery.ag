// Testnet courier bond. The recipient is a disclosed game oracle, not proof of physical delivery.
state DeliveryState {
    pubkey customer;
    pubkey courier;
    pubkey recipient;
    byte[32] world;
    byte[32] delivery_id;
    int payment;
    int bond;
    int refund_age;
}
actor Delivery owns DeliveryState {
    entry release(datasig receipt, sig courier_sig) emits none {
        require(payment > 0 && payment <= 1000000000000);
        require(bond > 0 && bond <= 1000000000000);
        require(refund_age > 0 && refund_age <= 4294967295);
        require(byte[32](customer) != byte[32](courier) && byte[32](recipient) != byte[32](courier));
        require(self.value == payment + bond);
        // Fixed domain plus world, unique covenant, delivery ID and all economic terms.
        byte[32] domain = sha256(byte[]("V5DeliveryReceipt:testnet-10:v1"));
        byte[248] message = domain + world + self.cov_id + delivery_id + byte[32](customer) + byte[32](courier) + byte[32](recipient) + (payment as byte[8]) + (bond as byte[8]) + (refund_age as byte[8]);
        require(checkMsgSig(receipt, sha256(byte[](message)), recipient));
        require(checkSig(courier_sig, courier));
        require(this.activeInputIndex == 0);
        require(tx.outputs[0].value == payment + bond);
        byte[36] destination = new ScriptPubKeyP2PK(courier);
        require(tx.outputs[0].scriptPubKey == byte[](destination));
    }
    entry refund(sig customer_sig) emits none {
        require(payment > 0 && payment <= 1000000000000);
        require(bond > 0 && bond <= 1000000000000);
        require(refund_age > 0 && refund_age <= 4294967295);
        require(byte[32](customer) != byte[32](courier) && byte[32](recipient) != byte[32](courier));
        require(self.value == payment + bond);
        require(checkSig(customer_sig, customer));
        require(this.ageDaa >= refund_age);
        require(this.activeInputIndex == 0);
        require(tx.outputs[0].value == payment + bond);
        byte[36] destination = new ScriptPubKeyP2PK(customer);
        require(tx.outputs[0].scriptPubKey == byte[](destination));
    }
}
app DeliveryApp { actor Delivery; }
