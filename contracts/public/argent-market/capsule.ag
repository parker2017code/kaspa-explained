state BusinessState {
    pubkey owner;
    pubkey issuer;
    byte[32] world;
    int sequence;
    int last_coin;
    int crops;
    int wood;
    int ore;
    int tools;
    int bread;
    pubkey operator;
    int allow_crops;
    int allow_wood;
    int allow_ore;
    int allow_tools;
    int allow_bread;
    int allow_coin;
    int min_receive;
}
