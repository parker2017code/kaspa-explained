# syntax=docker/dockerfile:1.7
FROM --platform=linux/amd64 node:22-bookworm AS native

ARG RUST_VERSION=1.94.0
ARG SILVERSCRIPT_REVISION=c7d17a15ac88610d013ec9ffffa9520aeb69929b
ENV PATH=/root/.cargo/bin:$PATH \
    CARGO_NET_GIT_FETCH_WITH_CLI=true
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git build-essential pkg-config libssl-dev unzip \
 && rm -rf /var/lib/apt/lists/* \
 && curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
 && rustc --version | grep -F "rustc ${RUST_VERSION}"

COPY package.json package-lock.json ./
COPY scripts ./scripts
COPY contracts ./contracts
COPY src ./src
COPY server ./server
COPY faucet ./faucet
COPY tests ./tests

# Downloads the pinned public Kaspa SDK/compiler archives and verifies their
# checked-in SHA-256 digests. No signer or local cache enters the image.
RUN node scripts/setup-testnet.mjs
RUN git clone --filter=blob:none https://github.com/kaspanet/silverscript.git .cache/upstream/silverscript \
 && git -C .cache/upstream/silverscript checkout --detach "${SILVERSCRIPT_REVISION}" \
 && test "$(git -C .cache/upstream/silverscript rev-parse HEAD)" = "${SILVERSCRIPT_REVISION}"
RUN node scripts/setup-v6-vm.mjs \
 && node scripts/setup-v6-proof.mjs \
 && node scripts/v6-proof-artifact.mjs \
 && node scripts/build-public-templates.mjs

FROM native AS verify
RUN node --test tests/v6-proof.test.mjs tests/v6-service.test.mjs tests/v6-network.test.mjs \
 && node scripts/build-public-templates.mjs --check-vm \
 && node scripts/check-v6-protocol-journey.mjs

FROM --platform=linux/amd64 node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    PORT=8080 \
    V6_PORT=8080
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home v6
COPY --from=native --chown=v6:v6 /app/server/v6-cloud.mjs /app/server/v6-cloud-storage.mjs /app/server/v6-network.mjs /app/server/v6-service.mjs /app/server/v6-vm.mjs ./server/
COPY --from=native --chown=v6:v6 /app/faucet/policy.mjs /app/faucet/v5-advanced-service.mjs /app/faucet/v5-market-service.mjs /app/faucet/v5-service.mjs ./faucet/
COPY --from=native --chown=v6:v6 /app/src/public-acceptance.mjs /app/src/public-asset-signing.mjs /app/src/public-contracts.mjs /app/src/public-v4-protocol.mjs /app/src/v5-argent-protocol.mjs /app/src/v5-delivery-protocol.mjs /app/src/v5-economy.mjs /app/src/v5-market.mjs /app/src/v5-ring-protocol.mjs /app/src/v6-proof-protocol.mjs /app/src/v5-argent-templates.json /app/src/v5-advanced-templates.json /app/src/v6-proof-templates.json ./src/
COPY --from=native --chown=v6:v6 /app/.cache/public-templates ./.cache/public-templates
COPY --from=native --chown=v6:v6 /app/.cache/upstream/kaspa-wasm32-sdk/nodejs/kaspa ./.cache/upstream/kaspa-wasm32-sdk/nodejs/kaspa
COPY --from=native --chown=v6:v6 /app/.cache/upstream/silverscript/target/debug/ke-v6-vm ./.cache/upstream/silverscript/target/debug/ke-v6-vm
COPY --from=native --chown=v6:v6 /app/scripts/v6-proof-prover/target/debug/v6-proof-prover ./scripts/v6-proof-prover/target/debug/v6-proof-prover
USER v6
RUN node --input-type=module -e "await Promise.all([import('./server/v6-cloud.mjs'), import('./src/v6-proof-protocol.mjs')])"
EXPOSE 8080
CMD ["node", "server/v6-cloud.mjs"]
