{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *.html *.yml *.md *.css *.js *.svg CNAME favicon.svg)",
      "Bash(git commit -m *)",
      "Bash(python3 -c *)",
      "Bash(grep -r *)",
      "Bash(find . *)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(rm -rf *)"
    ]
  }
}
